        "required": [
          "ticker",
          "weight",
          "marginal_contribution",
          "component_var",
          "pct_of_var"
        ],
        "title": "AssetContribution",
        "type": "object"
      },
      "AttributionRequest": {
        "properties": {
          "confidence_level": {
            "default": 0.99,
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.5,
            "title": "Confidence Level",
            "type": "number"
          },
          "cov_source": {
            "default": "ewma",
            "enum": [
              "ewma",
              "ledoit_wolf",
              "garch_hybrid"
            ],
            "title": "Cov Source",
            "type": "string"
          },
          "weights": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Weights",
            "type": "object"
          }
        },
        "required": [
          "weights"
        ],
        "title": "AttributionRequest",
        "type": "object"
      },
      "AttributionResponse": {
        "properties": {
          "confidence_level": {
            "title": "Confidence Level",
            "type": "number"
          },
          "contributions": {
            "items": {
              "$ref": "#/components/schemas/AssetContribution"
            },
            "title": "Contributions",
            "type": "array"
          },
          "portfolio_var": {
            "title": "Portfolio Var",
            "type": "number"
          },
          "sum_check": {
            "description": "Should equal portfolio_var within float tolerance",
            "title": "Sum Check",
            "type": "number"
          }
        },
        "required": [
          "confidence_level",
          "portfolio_var",
          "contributions",
          "sum_check"
        ],
        "title": "AttributionResponse",
        "type": "object"
      },
