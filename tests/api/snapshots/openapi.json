          "marginal_contribution": {
            "title": "Marginal Contribution",
            "type": "number"
          },
          "pct_of_var": {
            "title": "Pct Of Var",
            "type": "number"
          },
          "ticker": {
            "title": "Ticker",
            "type": "string"
          },
          "weight": {
            "title": "Weight",
            "type": "number"
          }
